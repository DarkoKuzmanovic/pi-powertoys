{
  "name": "pi-powertoys",
  "version": "1.0.0",
  "description": "Collection of standalone Pi coding agent extensions — compact model offload, speedtest benchmark, context enforcer, session guard, context meter, color tags, circuit breaker, contextual working messages, intent tracer, JSON guard, agent steering, system-prompt snippets, context viewer, ultrathink status chip, Kitty attention notifications, and extension linting",
  "author": "Darko Kuzmanovic",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkoKuzmanovic/pi-powertoys.git"
  },
  "homepage": "https://github.com/DarkoKuzmanovic/pi-powertoys#readme",
  "bugs": {
    "url": "https://github.com/DarkoKuzmanovic/pi-powertoys/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "toys",
    "extensions",
    "tools",
    "collection"
  ],
  "files": [
    "toys/*.ts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "pi": {
    "extensions": [
      "./toys/compact-model.ts",
      "./toys/speedtest.ts",
      "./toys/context-enforcer.ts",
      "./toys/session-guard.ts",
      "./toys/context.ts",
      "./toys/color.ts",
      "./toys/circuit-breaker.ts",
      "./toys/contextual-working.ts",
      "./toys/intent-tracer.ts",
      "./toys/json-guard.ts",
      "./toys/agent-steer.ts",
      "./toys/sys-prompt.ts",
      "./toys/context-viewer.ts",
      "./toys/ultrathink.ts",
      "./toys/kitty-attention.ts",
      "./toys/lint.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^24.13.1",
    "typescript": "^5.8.0"
  }
}
