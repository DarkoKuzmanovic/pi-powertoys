{
  "name": "pi-powertoys",
  "version": "1.0.0",
  "description": "Collection of standalone Pi coding agent extensions — compact model offload, speedtest benchmark, context meter, contextual working messages, intent tracer, agent steering, context viewer, Kitty attention notifications, extension linting, shortcut help overlay, and an away-from-keyboard commit-signing toggle",
  "author": "Darko Kuzmanovic",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkoKuzmanovic/pi-powertoys.git"
  },
  "homepage": "https://github.com/DarkoKuzmanovic/pi-powertoys#readme",
  "bugs": {
    "url": "https://github.com/DarkoKuzmanovic/pi-powertoys/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "toys",
    "extensions",
    "tools",
    "collection"
  ],
  "files": [
    "toys/*.ts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --test toys/startup-benchmark.test.ts toys/compact-model.test.ts toys/shortcut-help.test.ts"
  },
  "pi": {
    "extensions": [
      "./toys/compact-model.ts",
      "./toys/speedtest.ts",
      "./toys/startup-benchmark.ts",
      "./toys/context.ts",
      "./toys/contextual-working.ts",
      "./toys/intent-tracer.ts",
      "./toys/agent-steer.ts",
      "./toys/context-viewer.ts",
      "./toys/kitty-attention.ts",
      "./toys/lint.ts",
      "./toys/shortcut-help.ts",
      "./toys/afk.ts",
      "./toys/prompt-doctor.ts"
    ]
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {}
}
